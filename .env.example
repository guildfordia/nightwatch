# Nightwatch Environment Configuration
# Copy this file to .env and modify as needed
# Most values are auto-generated by: make install

# ── Node Identity (auto-set by setup-rpi.sh) ──
PI_NUMBER=1
MESH_IP=192.168.199.101

# ── Mesh Network (802.11s + batman-adv) ──
MESH_IFACE=wlan1
MESH_ID=nightwatch
# CdC §3.3 — mesh fixed on channel 11 (2462 MHz). hostapd APs use ACS on
# channels {1, 6} only, so the mesh never shares spectrum with a visitor AP
# on the same node. Channels 1/6/11 are the only non-overlap 2.4 GHz triplet.
FREQ=2462
# Optional: SAE encryption for mesh links (leave empty for open mesh)
# MESH_SAE_PASSWORD=your-mesh-secret

# ── Regulatory domain (CdC §6.1 — France ARCEP, ≤ 100 mW PIRE on 2.4 GHz) ──
# Drives both `iw reg set` (kernel-wide) and hostapd's country_code.
# Override per deployment country if you ship outside France.
COUNTRY_CODE=FR

# ── WiFi Access Point (hostapd on second USB dongle) ──
# A second AR9271 dongle runs hostapd as a WiFi AP. Each node broadcasts the
# same SSID with its dongle's own hardware BSSID (unique per node) — phones
# see multiple "Nightwatch" APs and switch to the strongest. The bssid= line
# in generated hostapd.conf is commented out, so AP_BSSID below is currently
# unused; it remains here for the (deprecated) shared-BSSID experiment, which
# Samsung phones rejected. hostapd adds AP_IFACE to br0 automatically via its
# bridge= directive.
AP_IFACE=wlan2
# AP_CHANNEL: 0 = ACS auto-select between channels 1 and 6 at startup (recommended,
# lets hostapd pick the least-congested non-overlap channel).
# Set explicitly to 1 or 6 to pin the AP to that channel. Channel 11 is reserved
# fleet-wide for the mesh; do not put an AP on it.
AP_CHANNEL=0
AP_BSSID=02:00:4E:57:00:01
WIFI_SSID=Nightwatch
WIFI_PASSWORD=Nightwatch

# ── Exposition Mode (CdC §3.4 #13) ──
# production    Default: only /nick and /help are available in chat.
#               Diagnostic endpoints (/api/blink, /api/debug, /api/bridge-status)
#               return 403. Use this for any public exhibition.
# debug         Diagnostic commands (/blink, /nodes, /debug) and their endpoints
#               are enabled. Use this only during development/lab tests.
NIGHTWATCH_MODE=production

# ── LCEN/RGPD legal disclosures (CdC §3.4 #12, §6.2, §6.3, Annexe A) ──
# These are surfaced in the chat banner. All three are OPTIONAL — leave
# empty for private/lab installations. When the installation is open to
# the public, fill them in for full LCEN art. 6-III + RGPD art. 13-14
# compliance.
#
# Email displayed in the chat banner via mailto: link, allowing visitors to
# report illegal content (LCEN art. 6-I-7). Operated by the commanditaire.
# If left at NON_DEFINI, the bridge logs a WARNING in journalctl on startup.
SIGNALEMENT_EMAIL=NON_DEFINI@nightwatch.local

# Identity of the responsable de publication / hébergeur (commanditaire).
# Free-form single line — typically: name, postal address, SIRET or MdA.
# Surfaced as "Responsable / hébergeur (LCEN art. 6-III) : ..." in the
# banner when non-empty.
LEGAL_OPERATOR_INFO=

# Dedicated RGPD contact email for exercising rights (art. 15-22). When
# empty, the banner reuses SIGNALEMENT_EMAIL with the [RGPD]/[SIGNALEMENT]
# subject convention from Annexe A.4. When set, used directly with no
# prefix instructions.
LEGAL_RGPD_EMAIL=

# OPTIONAL EXTRA BANNER CONTENT — beyond the structured fields above, drop
# arbitrary HTML at html/banner-extra.html (see html/banner-extra.html.example
# for the verbatim Annexe A.1 text). When present, that content is inserted
# at the bottom of the chat banner. Useful when the commanditaire wants the
# full Annexe A wording rather than the minimal structured form.

# ── App Services (ngircd, irc-bridge, nginx) ──
IRC_PORT=6667
NGINX_PORT=80

# ── IRC Federation ──
# Nodes discover each other automatically via UDP broadcast.
# This password secures the IRC server-to-server links.
IRC_LINK_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# ── Tailscale (optional — for remote SSH access) ──
# Generate a reusable auth key at: https://login.tailscale.com/admin/settings/keys
# Use a reusable key so multiple Pis can join unattended.
# Leave empty to skip Tailscale installation.
TAILSCALE_AUTH_KEY=

# ── Hugging Face (reserved for future use — currently unused) ──
# Plumbed through to the SD card secrets but not consumed by any service today.
# The sentiment-bridge (in nightwatch-sound, on the Mac) uses public HF models
# anonymously and does not read this token. Kept here for forward compatibility
# in case HF tightens anonymous access or a Pi-side ML feature is added later.
# Generate at: https://huggingface.co/settings/tokens
HF_TOKEN=
