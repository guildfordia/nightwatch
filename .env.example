# Nightwatch Environment Configuration
# Copy this file to .env and modify as needed

# ── Node Identity (UNIQUE per Pi) ──
PI_NUMBER=1
MESH_IP=192.168.199.101

# ── Mesh Network (802.11s + batman-adv) ──
MESH_IFACE=wlan1
MESH_ID=nightwatch
FREQ=2412
# Optional: SAE encryption for mesh links (leave empty for open mesh)
# MESH_SAE_PASSWORD=your-mesh-secret

# ── Access Point (hotspot for client devices) ──
AP_IFACE=wlan0
AP_SSID=Nightwatch
AP_CHANNEL=6
# Optional: WPA2 password (min 8 chars, leave empty for open AP)
# AP_PASSWORD=your-ap-password

# ── Gateway (set to true on the node with internet) ──
MESH_GATEWAY=false
# INET_IFACE=eth0

# ── Docker Services ──
IRC_PORT=6667
BRIDGE_PORT=8080
NGINX_PORT=80
DOCKER_NETWORK=nightwatch-net

# ── Distributed IRC Configuration ──
DISTRIBUTED_IRC=true
IRC_LINK_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# Server names and mesh IPs for each Pi
PI1_SERVER_NAME=node1.nightwatch.irc
PI1_MESH_IP=192.168.199.101
PI2_SERVER_NAME=node2.nightwatch.irc
PI2_MESH_IP=192.168.199.102
PI3_SERVER_NAME=node3.nightwatch.irc
PI3_MESH_IP=192.168.199.103
# Add more as needed:
# PI4_SERVER_NAME=node4.nightwatch.irc
# PI4_MESH_IP=192.168.199.104
