# Nightwatch Environment Configuration
# Copy this file to .env and modify as needed

# IRC Configuration
IRC_PORT=6667

# Kiwi IRC Web Interface
KIWI_PORT=8080

# Nginx Configuration
NGINX_PORT=80

# Docker Network
DOCKER_NETWORK=irc-net

# BATMAN Mesh Configuration
IFACE=wlan0
MESH_ID=batmesh
FREQ=2412

# MESH_IP will be assigned automatically by the setup script.
# Uncomment and set manually ONLY if you need a specific IP.
# MESH_IP=192.168.199.10

# Optional: Override default mesh IP range
# MESH_SUBNET=192.168.199.0/24