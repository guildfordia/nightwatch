# Nightwatch Environment Configuration
# Copy this file to .env and modify as needed

# IRC Configuration
IRC_PORT=6667

# Kiwi IRC Web Interface
KIWI_PORT=8080

# Nginx Configuration
NGINX_PORT=80

# Docker Network
DOCKER_NETWORK=irc-net

# BATMAN Mesh Configuration
IFACE=wlan1
MESH_ID=batmesh
FREQ=2412

# MESH_IP will be assigned automatically by the setup script.
# Uncomment and set manually ONLY if you need a specific IP.
MESH_IP=192.168.199.101

# Optional: Override default mesh IP range
# MESH_SUBNET=192.168.199.0/24


# Distributed IRC Server Configuration
# Set this Pi's number (1, 2, 3, or 4)
PI_NUMBER=1

# IRC Server linking password (same for all Pis)
IRC_LINK_PASSWORD=meshpass123

# Mesh network IPs for all Pis (update with your actual IPs)
PI1_MESH_IP=192.168.199.101
PI2_MESH_IP=192.168.199.102
PI3_MESH_IP=192.168.199.103
PI4_MESH_IP=192.168.199.104

# IRC Server names for each Pi
PI1_SERVER_NAME=blacknode.nightwatch.irc
PI2_SERVER_NAME=greennode.nightwatch.irc
PI3_SERVER_NAME=bluenode.nightwatch.irc
PI4_SERVER_NAME=rednode.nightwatch.irc

# Enable distributed IRC mode (true/false)
DISTRIBUTED_IRC=true