# Nightwatch Environment Configuration
# Copy this file to .env and modify as needed
# Most values are auto-generated by: make install

# ── Node Identity (auto-set by setup-rpi.sh) ──
PI_NUMBER=1
MESH_IP=192.168.199.101

# ── Mesh Network (802.11s + batman-adv) ──
MESH_IFACE=wlan1
MESH_ID=nightwatch
FREQ=2412
# Optional: SAE encryption for mesh links (leave empty for open mesh)
# MESH_SAE_PASSWORD=your-mesh-secret

# ── Client Access (GL.iNet router connected via ethernet) ──
# eth0 is bridged into batman-adv so clients on the router can reach the mesh.
# The router handles WiFi AP — no hostapd needed on the Pi.
AP_IFACE=eth0

# ── Gateway (set to true on the node with internet) ──
MESH_GATEWAY=false
# INET_IFACE=wlan0

# ── GL.iNet Router (GL-MT300N-V2, connected via eth0) ──
# The setup script configures the router as a dumb AP (bridge mode).
# Clients connect to the WiFi and reach the mesh through eth0 → br0 → bat0.
ROUTER_IP=192.168.8.1
ROUTER_CONFIGURED_IP=192.168.8.100
ROUTER_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
WIFI_SSID=Nightwatch
WIFI_PASSWORD=Nightwatch

# ── Docker Services ──
IRC_PORT=6667
BRIDGE_PORT=8080
NGINX_PORT=80
DOCKER_NETWORK=nightwatch-net

# ── IRC Federation ──
# Nodes discover each other automatically via UDP broadcast.
# This password secures the IRC server-to-server links.
IRC_LINK_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

# ── Tailscale (optional — for remote SSH access) ──
# Generate a reusable auth key at: https://login.tailscale.com/admin/settings/keys
# Use a reusable key so multiple Pis can join unattended.
# Leave empty to skip Tailscale installation.
TAILSCALE_AUTH_KEY=
