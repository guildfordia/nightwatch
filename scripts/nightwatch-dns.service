[Unit]
Description=Nightwatch DNS Fix (ensure 8.8.8.8 in resolv.conf)
Before=nightwatch-mesh.service
After=network.target tailscaled.service
Wants=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c 'grep -q "8.8.8.8" /etc/resolv.conf 2>/dev/null || echo "nameserver 8.8.8.8" >> /etc/resolv.conf'
ExecStartPost=/bin/bash -c 'echo "[+] DNS fix applied: 8.8.8.8 in resolv.conf"'

[Install]
WantedBy=multi-user.target
