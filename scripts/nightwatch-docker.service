[Unit]
Description=Nightwatch Docker Services (IRC, bridge, nginx)
After=nightwatch-mesh.service docker.service
Requires=nightwatch-mesh.service docker.service
PartOf=nightwatch-mesh.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nightwatch
ExecStart=/usr/bin/docker compose --env-file /opt/nightwatch/.env up -d
ExecStop=/usr/bin/docker compose --env-file /opt/nightwatch/.env down
TimeoutStartSec=120
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
