[Unit]
Description=Nightwatch Docker Services (IRC, bridge, nginx)
After=nightwatch-mesh.service docker.service
Requires=nightwatch-mesh.service docker.service
PartOf=nightwatch-mesh.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/nightwatch
ExecStart=/bin/bash -c 'if docker compose version >/dev/null 2>&1; then docker compose --env-file .env up -d; else docker-compose --env-file .env up -d; fi'
ExecStop=/bin/bash -c 'if docker compose version >/dev/null 2>&1; then docker compose --env-file .env down; else docker-compose --env-file .env down; fi'
TimeoutStartSec=120
Restart=on-failure
RestartSec=30
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
