[Unit]
Description=Nightwatch Mesh Network (802.11s + batman-adv + AP)
After=network.target sys-subsystem-net-devices-wlan1.device sys-subsystem-net-devices-wlan2.device
Wants=network.target
Wants=sys-subsystem-net-devices-wlan1.device
Wants=sys-subsystem-net-devices-wlan2.device

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/nightwatch/scripts/mesh-fix.sh start
ExecStop=/opt/nightwatch/scripts/mesh-fix.sh stop
ExecReload=/opt/nightwatch/scripts/mesh-fix.sh stop ; /opt/nightwatch/scripts/mesh-fix.sh start

[Install]
WantedBy=multi-user.target
