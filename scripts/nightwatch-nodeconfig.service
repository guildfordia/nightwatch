[Unit]
Description=Nightwatch Node Auto-Configuration
Before=nightwatch-mesh.service
Before=docker.service
After=local-fs.target network.target
Wants=network.target

[Service]
Type=oneshot
ExecStart=/opt/nightwatch/scripts/nodeconfig.sh
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
