[Unit]
Description=Nightwatch Node Discovery (UDP broadcast)
After=nightwatch-mesh.service
Requires=nightwatch-mesh.service
PartOf=nightwatch-mesh.service

[Service]
Type=simple
ExecStart=/opt/nightwatch/scripts/node-discovery.sh start
ExecStop=/opt/nightwatch/scripts/node-discovery.sh stop
Restart=on-failure
RestartSec=10
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
