[Unit]
Description=Nightwatch First Boot Setup
After=network-online.target
Wants=network-online.target
Before=nightwatch-nodeconfig.service nightwatch-mesh.service
ConditionPathExists=!/opt/nightwatch/.firstboot-done

[Service]
Type=oneshot
ExecStart=/opt/nightwatch/scripts/firstboot.sh
RemainAfterExit=no
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
