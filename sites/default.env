# sites/default.env — defaults shared by all deployments unless overridden.
# Per-site override files (paris-2026.env, etc.) live alongside this one and
# are gitignored to keep secrets out of the repo.

SITE_NAME=default
MESH_ID=nightwatch
WIFI_SSID=Nightwatch
WIFI_PASSWORD=Nightwatch
FREQ=2412
AP_CHANNEL=6
AP_BSSID=02:00:4E:57:00:01
# MESH_SAE_PASSWORD intentionally not set here — must be generated per-site.
# See docs/multi-site-deployment.md.
